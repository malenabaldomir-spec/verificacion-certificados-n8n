    {
      "parameters": {
        "jsCode": "// Quita tildes para comparar nombres de campo sin importar acentos\nfunction normalizar(str) {\n  return str.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\n}\n\nfunction buscarValorPorNombreParcial(fields, palabraClave) {\n  for (const [key, value] of Object.entries(fields || {})) {\n    if (normalizar(key).includes(palabraClave)) return value;\n  }\n  return '';\n}\n\nconst original = $('IF - Datos Completos').item.json;\n\nconst camposLimpios = {};\nfor (const [key, value] of Object.entries(original.fields || {})) {\n  camposLimpios[key.trim()] = value;\n}\n\nconst targetMail = (camposLimpios.mail || '').toString().trim().toLowerCase();\nconst targetCurso = (camposLimpios.cursos || '').toString().trim().toLowerCase();\n\nconst todos = $input.all();\nconst tieneCertificado = todos.some(item => {\nconst f = item.json.fields || item.json;\n  const mail = buscarValorPorNombreParcial(f, 'correo').toString().trim().toLowerCase();\n  const curso = buscarValorPorNombreParcial(f, 'curso').toString().trim().toLowerCase();\n  return mail === targetMail && curso === targetCurso;\n});\n\nreturn [{\n  json: {\n    id: original.id,\n    ...camposLimpios,\n    TieneCertificado: tieneCertificado\n  }\n}];"
      },
      "id": "11f4f2e0-458b-485b-9c29-8dfde72a0c97",
      "name": "Evaluar Resultado Busqueda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3680,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash: ...generateContent?key=TU_API_KEY_ACA,
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({contents: [{parts: [{text: \"Eres un asistente de una academia. Redacta un correo breve para \" + $json['Nombre de completo'] + \" sobre el curso \" + $json.cursos + \". Tiene certificado: \" + $json.TieneCertificado + \". Si es true, informa que ya lo tiene. Si es false, confirma la inscripcion y da la bienvenida. Responde solo el cuerpo del correo.\"}]}]}) }}",
        "options": {}
      },
      "id": "cbe2e68e-e04b-445e-8428-6e17cb007c37",
      "name": "IA - Redactar Mensaje (HTTP Request)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -3456,
        320
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text || '';\nreturn [{\n  json: {\n    ...$('Evaluar Resultado Busqueda').item.json,\n    MensajeIA: raw.trim()\n  }\n}];"
      },
